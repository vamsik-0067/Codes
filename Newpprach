import os
import sys
import re

# ---------------------------------------------------
# QUTS PATH
# ---------------------------------------------------
sys.path.append(r"C:\Program Files (x86)\Qualcomm\QUTS\Support\python")

import QutsClient
import Common.ttypes
import LogSession.ttypes

# ---------------------------------------------------
# INPUT HDF FILE
# ---------------------------------------------------
HDF_FILE = r"C:\Logs\nas_logging_20260527_130300.hdf"

# OUTPUT FILE
OUTPUT_FILE = r"C:\Logs\throughput_only.txt"


# ---------------------------------------------------
# MAIN FUNCTION
# ---------------------------------------------------
def process_files(log_session):

    data_packet_filter = LogSession.ttypes.DataPacketFilter()

    # ---------------------------------------------------
    # GET DEVICE
    # ---------------------------------------------------
    device_list = log_session.getDeviceList()
    if not device_list:
        print("❌ No device found")
        return

    # ---------------------------------------------------
    # GET PROTOCOL HANDLE (DIAG)
    # ---------------------------------------------------
    protocols = log_session.getProtocolList(device_list[0].deviceHandle)

    for proto in protocols:
        if proto.protocolType == Common.ttypes.ProtocolType.PROT_DIAG:
            data_packet_filter.protocolHandleList = [proto.protocolHandle]
            print("✅ DIAG protocol selected")
            break

    # ---------------------------------------------------
    # FILTER (VERY IMPORTANT ✅)
    # ---------------------------------------------------
    diag_filter = Common.ttypes.DiagPacketFilter()

    log_filters = [
        Common.ttypes.DiagIdFilterItem(regexFilter="NR5GMAC"),
        Common.ttypes.DiagIdFilterItem(regexFilter="ENL2DL"),
        Common.ttypes.DiagIdFilterItem(regexFilter="ENL2UL"),
        Common.ttypes.DiagIdFilterItem(regexFilter="tput"),
        Common.ttypes.DiagIdFilterItem(regexFilter="Kbps"),
        Common.ttypes.DiagIdFilterItem(regexFilter="avgPHY")
    ]

    diag_filter.idOrNameMask = {
        Common.ttypes.DiagPacketType.LOG_PACKET: log_filters
    }

    data_packet_filter.diagFilter = diag_filter

    # ---------------------------------------------------
    # RETURN CONFIG
    # ---------------------------------------------------
    ret_cfg = Common.ttypes.DiagReturnConfig()
    ret_cfg.flags = (
        Common.ttypes.DiagReturnFlags.PACKET_NAME |
        Common.ttypes.DiagReturnFlags.TIME_STAMP_STRING |
        Common.ttypes.DiagReturnFlags.PARSED_TEXT
    )

    packet_cfg = LogSession.ttypes.PacketReturnConfig()
    packet_cfg.diagConfig = ret_cfg

    # ---------------------------------------------------
    # CREATE VIEW
    # ---------------------------------------------------
    log_session.createDataView("data", data_packet_filter, packet_cfg)

    # ---------------------------------------------------
    # GET DATA RANGE
    # ---------------------------------------------------
    packet_range = LogSession.ttypes.PacketRange()
    packet_range.beginIndex = 0
    packet_range.endIndex = log_session.getDataPacketCount(
        data_packet_filter.protocolHandleList[0]
    )

    print("Total packets:", packet_range.endIndex)

    data_packets = log_session.getDataViewItems("data", packet_range)

    print("Filtered packets:", len(data_packets))

    # ---------------------------------------------------
    # EXTRACT THROUGHPUT ✅
    # ---------------------------------------------------
    with open(OUTPUT_FILE, "w") as f:

        for pkt in data_packets:

            if pkt.diagPacket is None:
                continue

            text = str(pkt.diagPacket.parsedText)

            # ---------------------------------------------------
            # FILTER ONLY THROUGHPUT LINES
            # ---------------------------------------------------
            if ("NR5GMAC" in text or "ENL2DL" in text or "ENL2UL" in text):

                # DL throughput
                dl = re.search(r'DL.*avgPHY\.Kbps:\s*(\d+)', text)

                # UL throughput
                ul = re.search(r'UL.*avgPHY\.Kbps:\s*(\d+)', text)

                # tput PHY
                tput = re.search(r'tput\.kbps:\[.*?PHY:\s*(\d+)', text)

                # ---------------------------------------------------
                # WRITE CLEAN OUTPUT
                # ---------------------------------------------------
                if dl:
                    line = f"{pkt.diagPacket.timeStampString} | DL Throughput = {dl.group(1)} Kbps"
                    print(line)
                    f.write(line + "\n")

                elif ul:
                    line = f"{pkt.diagPacket.timeStampString} | UL Throughput = {ul.group(1)} Kbps"
                    print(line)
                    f.write(line + "\n")

                elif tput:
                    line = f"{pkt.diagPacket.timeStampString} | PHY Throughput = {tput.group(1)} Kbps"
                    print(line)
                    f.write(line + "\n")

    print("✅ Throughput extraction completed →", OUTPUT_FILE)

    log_session.removeDataView("data")


# ---------------------------------------------------
# EXECUTION
# ---------------------------------------------------
def main():

    if not os.path.exists(HDF_FILE):
        print("❌ File not found")
        return

    print("Opening HDF...")

    quts_client = QutsClient.QutsClient("ThroughputExtractor")

    log_session = quts_client.openLogSession([HDF_FILE])

    if log_session == 0:
        print("❌ Failed to open session")
        return

    process_files(log_session)


if __name__ == "__main__":
    main()
