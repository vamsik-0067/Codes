
 ---------------------------------
# CHECK LTE TARGET
# ---------------------------------
${LTE_OK}=    Set Variable    ${False}
IF    ${LTE_RSRP} >= ${LOWER_LIMIT} and ${LTE_RSRP} <= ${UPPER_LIMIT}
    ${LTE_OK}=    Set Variable    ${True}
END

# ---------------------------------
# FINAL CONDITION (LTE ONLY)
# ---------------------------------
IF    ${LTE_OK}
    Log To Console
    ...    TARGET ACHIEVED
    ${TARGET_FOUND}=    Set Variable    ${True}
ELSE
    IF    ${LTE_RSRP} > ${TARGET_RSRP}
        Log To Console
        ...    SIGNAL TOO STRONG
        ${attenuation1}=    Evaluate    ${attenuation1} + 5
    ELSE
        Log To Console
        ...    SIGNAL TOO WEAK
        ${attenuation1}=    Evaluate    ${attenuation1} - 5
    END

    IF    ${attenuation1} < 0
        ${attenuation1}=    Set Variable    0
    END

    Log To Console
    ...    NEW CH1 = ${attenuation1}
END
