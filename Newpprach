import os
import sys
import time

# ---------------------------------------------------
# QXDM PATH
# ---------------------------------------------------
sys.path.append(r"C:\Program Files\Qualcomm\QXDM5\Support\python")

import QxdmAutomationClient

# ---------------------------------------------------
# FILE PATH
# ---------------------------------------------------
hdfFile = r"C:\Logs\your_file.hdf"   # <-- change this

if not os.path.exists(hdfFile):
    print("HDF file not found!")
    exit()

# ---------------------------------------------------
# CREATE CLIENT
# ---------------------------------------------------
client = QxdmAutomationClient.QxdmAutomationClient("QXDMReader")
manager = client.getQxdmAutomationManager()

# ---------------------------------------------------
# INIT
# ---------------------------------------------------
manager.InitializeService()
manager.SetVisible(True)

# ---------------------------------------------------
# LOAD HDF FILE ✅ (KEY STEP)
# ---------------------------------------------------
print("Loading HDF file...")
ret = manager.LoadItemStore(hdfFile)

print("LoadItemStore:", ret)

if not ret:
    print("Failed to load HDF")
    exit()

# ---------------------------------------------------
# EXPORT DECODED LOGS
# ---------------------------------------------------
txtFile = hdfFile.replace(".hdf", "_decoded.txt")

print("Exporting decoded logs...")
manager.ExportView(txtFile)

print("Decoded file:", txtFile)

# ---------------------------------------------------
# FILTER THROUGHPUT LOGS
# ---------------------------------------------------
import subprocess

filteredFile = txtFile.replace(".txt", "_throughput.txt")

cmd = f'findstr /i "NR5GMAC ENL2DL tput Kbps avgPHY" "{txtFile}" > "{filteredFile}"'

subprocess.call(cmd, shell=True)

print("✅ Throughput logs:", filteredFile)

# ---------------------------------------------------
# DONE
# ---------------------------------------------------
manager.Close()

print("✅ Completed")
