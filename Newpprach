import os
import sys
import subprocess

# ---------------------------------------------------
# QXDM PYTHON PATH
# ---------------------------------------------------
sys.path.append(r"C:\Program Files\Qualcomm\QXDM5\Support\python")

import QxdmAutomationClient

# ---------------------------------------------------
# INPUT HDF FILE
# ---------------------------------------------------
hdfFile = r"C:\Logs\your_file.hdf"   # 👉 change this

if not os.path.exists(hdfFile):
    print("❌ HDF file not found")
    exit()

# ---------------------------------------------------
# CREATE CLIENT
# ---------------------------------------------------
print("Creating QXDM Client...")
client = QxdmAutomationClient.QxdmAutomationClient("QXDMReader")
manager = client.getQxdmAutomationManager()

# ---------------------------------------------------
# INITIALIZE
# ---------------------------------------------------
print("Initializing service...")
if not manager.InitializeService():
    print("❌ Initialization failed")
    exit()

manager.SetVisible(True)

# ---------------------------------------------------
# LOAD HDF FILE ✅
# ---------------------------------------------------
print("Loading HDF file...")
ret = manager.LoadItemStore(hdfFile)

if not ret:
    print("❌ Failed to load HDF")
    exit()

print("✅ HDF Loaded")

# ---------------------------------------------------
# EXPORT LOGS USING GetViewItems ✅ (NO ExportView)
# ---------------------------------------------------
decodedFile = hdfFile.replace(".hdf", "_decoded.txt")

print("Exporting logs...")

with open(decodedFile, "w", encoding="utf-8") as f:

    index = 0
    step = 1000

    while True:
        logs = manager.GetViewItems(index, index + step)

        if not logs:
            break

        for item in logs:
            f.write(str(item) + "\n")

        index += step

print("✅ Logs exported:", decodedFile)

# ---------------------------------------------------
# FILTER THROUGHPUT LOGS ✅
# ---------------------------------------------------
filteredFile = decodedFile.replace(".txt", "_throughput.txt")

print("Filtering throughput logs...")

cmd = f'findstr /i "NR5GMAC ENL2DL tput Kbps avgPHY" "{decodedFile}" > "{filteredFile}"'
subprocess.call(cmd, shell=True)

print("✅ Throughput logs saved:", filteredFile)

# ---------------------------------------------------
# CLOSE QXDM
# ---------------------------------------------------
manager.Close()

print("✅ COMPLETED SUCCESSFULLY")
