import subprocess
import os

# ---------------------------------------------------
# INPUT HDF FILE
# ---------------------------------------------------
hdf_file = r"C:\Logs\your_file.hdf"   # <-- change this

# ---------------------------------------------------
# OUTPUT TXT FILE
# ---------------------------------------------------
txt_file = hdf_file.replace(".hdf", "_throughput.txt")

# ---------------------------------------------------
# CHECK FILE EXISTS
# ---------------------------------------------------
if not os.path.exists(hdf_file):
    print("HDF file not found!")
    exit()

print("Processing file:", hdf_file)

# ---------------------------------------------------
# THROUGHPUT FILTER KEYWORDS
# ---------------------------------------------------
keywords = "throughput rate DL UL tx_rate rx_rate Transport_Block MAC"

# ---------------------------------------------------
# COMMAND
# ---------------------------------------------------
cmd = f'h5dump "{hdf_file}" | findstr /i "{keywords}" > "{txt_file}"'

# ---------------------------------------------------
# EXECUTE
# ---------------------------------------------------
print("Extracting throughput logs...")
subprocess.call(cmd, shell=True)

print("✅ Done!")
print("Output file:", txt_file)
